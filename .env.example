APP_ENV=production
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=mapdcasos.pythonanywhere.com
DJANGO_SECURE_SSL_REDIRECT=True
# Ative HSTS somente após confirmar HTTPS estável em produção.
DJANGO_HSTS_SECONDS=0

GEMINI_API_KEY=cole-sua-chave-aqui
# O SDK usa v1beta por padrão; é também o endpoint operacional recomendado para
# o MAPD Casos após 404 observados em /v1/interactions no PythonAnywhere.
GEMINI_API_VERSION=v1beta
# 3.6 Flash foi validado de ponta a ponta no projeto em produção. Modelos da família
# 2.5 (ex.: gemini-2.5-flash-lite) existem para generateContent, mas retornaram 404
# Not Found ao criar uma interação na API preview de Interactions para esta chave/
# projeto — os fallbacks abaixo ficam restritos à família 3.x, já confirmada nesse
# endpoint (ver `client.models.list()` e testes diretos em produção).
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_CHAT_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_EVALUATION_MODEL=gemini-3.6-flash
GEMINI_EVALUATION_FALLBACK_MODEL=gemini-3.5-flash
# Baixos de propósito: em modo síncrono (AI_BACKGROUND_ENABLED=False) esses valores
# multiplicam por até 3 níveis de fallback de modelo e bloqueiam o único worker
# gratuito enquanto isso. O gateway já tem retry entre modelos; retries de SDK e
# timeout maiores só aumentam o pior caso sem ganho proporcional de confiabilidade.
GEMINI_RETRY_ATTEMPTS=1
GEMINI_HTTP_TIMEOUT_MS=10000
GEMINI_CHAT_MAX_OUTPUT_TOKENS=512
GEMINI_EVALUATION_MAX_OUTPUT_TOKENS=1800
GEMINI_CHAT_THINKING_LEVEL=minimal
GEMINI_EVALUATION_THINKING_LEVEL=medium
GEMINI_FALLBACK_ON_QUOTA=True
GEMINI_CIRCUIT_FAILURE_THRESHOLD=5
GEMINI_CIRCUIT_COOLDOWN_SECONDS=45

AI_ENABLED=True
PATIENT_AI_ENABLED=True
EVALUATION_AI_ENABLED=True
# O polling (GET /interactions/{id}) do modo background retornou 400 invalid_request
# nesta chave/projeto contra a API preview de Interactions; o create() síncrono
# (background=False) funciona normalmente. Mantenha False até validar o polling.
AI_BACKGROUND_ENABLED=False
AI_SCHEMA_REPAIR_ATTEMPTS=1
AI_JOB_MAX_WAIT_SECONDS=75
AI_MAX_USER_MESSAGE_CHARS=2500

# PERFIL GRATUITO
# "auto" ativa limites conservadores quando production + SQLite + sem Redis.
# Nesse perfil os valores abaixo são automaticamente limitados a:
# 1 job/aluno, 20 jobs globais, 8 req/min/aluno, 60 req/min globais e 50 req/min/tipo.
FREE_TIER_PROFILE=auto
AI_MAX_PENDING_PER_USER=1
AI_MAX_PENDING_GLOBAL=20
AI_RATE_LIMIT_USER_PER_MINUTE=8
AI_RATE_LIMIT_GLOBAL_PER_MINUTE=60
AI_RATE_LIMIT_KIND_PER_MINUTE=50

SUPERUSER_USERNAME=rodrigo
SUPERUSER_NAME=Prof. Rodrigo Niskier
SUPERUSER_EMAIL=
SUPERUSER_PASSWORD=defina-uma-senha-forte

# PRODUÇÃO MULTIUSUÁRIO PLENA: PostgreSQL é recomendado. SQLite permanece no piloto gratuito.
# DATABASE_URL=postgresql://usuario:senha@host:porta/banco
DB_CONN_MAX_AGE=60

# CACHE COMPARTILHADO ENTRE MÚLTIPLOS WORKERS: Redis é recomendado.
# Com um único worker gratuito, o cache em arquivo permanece operacional.
# REDIS_URL=redis://usuario:senha@host:porta/0

APP_LOG_LEVEL=INFO
SESSION_COOKIE_AGE=28800
